{
  "name": "jotster",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "restore": "${TSONIC_BIN:-tsonic} restore",
    "build": "node scripts/build-all.mjs",
    "build:no-restore": "node scripts/build-all.mjs --skip-restore",
    "typecheck": "node scripts/typecheck-all.mjs",
    "typecheck:no-restore": "node scripts/typecheck-all.mjs --skip-restore",
    "pretest": "npm run build",
    "migrate": "npx knex --knexfile knexfile.jotster.js migrate:latest",
    "migrate:rollback": "npx knex --knexfile knexfile.jotster.js migrate:rollback",
    "migrate:make": "npx knex --knexfile knexfile.jotster.js migrate:make",
    "migrate:status": "npx knex --knexfile knexfile.jotster.js migrate:status",
    "report:api-compat": "node scripts/generate-api-compat-report.mjs",
    "verify-all": "bash ./scripts/verify-all.sh",
    "test": "node --import tsx scripts/run-tests.mjs",
    "test:no-build": "node --import tsx scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@tsonic/aspnetcore": "10.0.40",
    "@tsonic/core": "10.0.40",
    "@tsonic/dotnet": "10.0.40",
    "@tsonic/efcore": "10.0.39",
    "@tsonic/efcore-sqlite": "10.0.39",
    "@tsonic/express": "10.0.43",
    "@tsonic/js": "10.0.48",
    "@tsonic/microsoft-extensions": "10.0.40",
    "@tsonic/nodejs": "10.0.48",
    "@tsonic/tsbindgen": "0.7.51",
    "@types/node": "^24.12.2",
    "better-sqlite3": "^11.0.0",
    "chai": "^5.0.0",
    "knex": "^3.1.0",
    "mocha": "^10.0.0",
    "tsonic": "^0.0.74",
    "tsx": "^4.0.0",
    "typescript": "5.9.2"
  }
}
