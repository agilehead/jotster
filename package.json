{
  "name": "jotster",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "restore": "${TSONIC_BIN:-tsonic} restore",
    "build": "${TSONIC_BIN:-tsonic} restore && npm run -w @jotster/core build && npm run -w @jotster/identity build && npm run -w @jotster/authorization build && npm run -w @jotster/collaboration build && npm run -w @jotster/notifications build && npm run -w @jotster/api-native build && npm run -w @jotster/server build",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "pretest": "npm run build",
    "migrate": "npx knex --knexfile knexfile.jotster.js migrate:latest",
    "migrate:rollback": "npx knex --knexfile knexfile.jotster.js migrate:rollback",
    "migrate:make": "npx knex --knexfile knexfile.jotster.js migrate:make",
    "migrate:status": "npx knex --knexfile knexfile.jotster.js migrate:status",
    "report:api-surface": "node scripts/generate-api-surface-report.mjs",
    "verify-all": "bash ./scripts/verify-all.sh",
    "test": "NODE_OPTIONS='--import tsx' mocha tests/index.ts --timeout 60000"
  },
  "devDependencies": {
    "@tsonic/aspnetcore": "10.0.41",
    "@tsonic/core": "10.0.41",
    "@tsonic/dotnet": "10.0.41",
    "@tsonic/efcore": "10.0.41",
    "@tsonic/efcore-sqlite": "10.0.40",
    "@tsonic/express": "10.0.49",
    "@tsonic/js": "10.0.49",
    "@tsonic/microsoft-extensions": "10.0.41",
    "@tsonic/nodejs": "10.0.49",
    "@tsonic/tsbindgen": "0.7.52",
    "@types/node": "^24.12.2",
    "better-sqlite3": "^11.0.0",
    "chai": "^5.0.0",
    "knex": "^3.1.0",
    "mocha": "^10.0.0",
    "tsonic": "0.0.76",
    "tsx": "^4.0.0",
    "typescript": "5.9.2"
  }
}
