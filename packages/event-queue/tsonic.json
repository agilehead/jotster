{
  "$schema": "https://tsonic.org/schema/v1.json",
  "rootNamespace": "Jotster.EventQueue",
  "entryPoint": "src/index.ts",
  "sourceRoot": "src",
  "outputDirectory": "generated",
  "outputName": "Jotster.EventQueue",
  "output": {
    "type": "library"
  },
  "references": {
    "packages": [
      {
        "id": "@jotster/core",
        "project": "../core",
        "mode": "dll"
      }
    ]
  },
  "buildOptions": {
    "stripSymbols": true,
    "invariantGlobalization": true
  }
}
