{
  "$schema": "https://tsonic.org/schema/v1.json",
  "rootNamespace": "Jotster.Webhooks",
  "entryPoint": "src/index.ts",
  "sourceRoot": "src",
  "outputDirectory": "generated",
  "outputName": "Jotster.Webhooks",
  "output": {
    "type": "library"
  },
  "buildOptions": {
    "stripSymbols": true,
    "invariantGlobalization": true
  },
  "references": {
    "libraries": [
      "../core/dist/net10.0/Jotster.Core.dll",
      "../messages/dist/net10.0/Jotster.Messages.dll",
      "../event-queue/dist/net10.0/Jotster.EventQueue.dll",
      "../auth/dist/net10.0/Jotster.Auth.dll"
    ]
  }
}
