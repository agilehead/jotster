{
  "$schema": "https://tsonic.org/schema/v1.json",
  "rootNamespace": "Jotster.Subscriptions",
  "entryPoint": "src/index.ts",
  "sourceRoot": "src",
  "outputDirectory": "generated",
  "outputName": "Jotster.Subscriptions",
  "output": {
    "type": "library"
  },
  "buildOptions": {
    "stripSymbols": true,
    "invariantGlobalization": true
  },
  "references": {
    "packages": [
      {
        "id": "@jotster/core",
        "project": "../core",
        "mode": "dll"
      },
      {
        "id": "@jotster/channels",
        "project": "../channels",
        "mode": "dll"
      }
    ]
  }
}
