{
  "$schema": "https://tsonic.org/schema/v1.json",
  "rootNamespace": "Jotster.Server",
  "entryPoint": "src/app.ts",
  "sourceRoot": "src",
  "outputDirectory": "generated",
  "outputName": "jotster",
  "optimize": "speed",
  "output": {
    "nativeAot": false,
    "trimmed": false,
    "singleFile": false
  },
  "buildOptions": {
    "stripSymbols": true,
    "invariantGlobalization": true
  },
  "references": {
    "packages": [
      {
        "id": "@jotster/core",
        "project": "../core"
      },
      {
        "id": "@jotster/identity",
        "project": "../identity"
      },
      {
        "id": "@jotster/authorization",
        "project": "../authorization"
      },
      {
        "id": "@jotster/collaboration",
        "project": "../collaboration"
      },
      {
        "id": "@jotster/notifications",
        "project": "../notifications"
      },
      {
        "id": "@jotster/api-native",
        "project": "../api-native"
      }
    ]
  }
}
