{
  "$schema": "https://tsonic.org/schema/v1.json",
  "rootNamespace": "Jotster.Server",
  "entryPoint": "src/app.ts",
  "sourceRoot": "src",
  "outputDirectory": "generated",
  "outputName": "jotster",
  "optimize": "speed",
  "output": {
    "nativeAot": false,
    "trimmed": false,
    "singleFile": false
  },
  "buildOptions": {
    "stripSymbols": true,
    "invariantGlobalization": true
  },
  "references": {
    "packages": [
      {
        "id": "@jotster/core",
        "project": "../core"
      },
      {
        "id": "@jotster/auth",
        "project": "../auth"
      },
      {
        "id": "@jotster/channels",
        "project": "../channels"
      },
      {
        "id": "@jotster/drafts",
        "project": "../drafts"
      },
      {
        "id": "@jotster/emoji",
        "project": "../emoji"
      },
      {
        "id": "@jotster/event-queue",
        "project": "../event-queue"
      },
      {
        "id": "@jotster/messages",
        "project": "../messages"
      },
      {
        "id": "@jotster/notifications",
        "project": "../notifications"
      },
      {
        "id": "@jotster/organization",
        "project": "../organization"
      },
      {
        "id": "@jotster/permissions",
        "project": "../permissions"
      },
      {
        "id": "@jotster/presence",
        "project": "../presence"
      },
      {
        "id": "@jotster/subscriptions",
        "project": "../subscriptions"
      },
      {
        "id": "@jotster/uploads",
        "project": "../uploads"
      },
      {
        "id": "@jotster/users",
        "project": "../users"
      },
      {
        "id": "@jotster/webhooks",
        "project": "../webhooks"
      }
    ]
  }
}
