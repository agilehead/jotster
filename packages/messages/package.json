{
  "name": "@jotster/messages",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./dist/tsonic/bindings/*.d.ts",
      "default": "./dist/tsonic/bindings/*.js"
    }
  },
  "scripts": {
    "typecheck": "cd ../.. && ${TSONIC_BIN:-tsonic} restore --project messages && cd packages/messages && tsc -p tsconfig.json",
    "build": "cd ../.. && ${TSONIC_BIN:-tsonic} build --project messages"
  }
}
